# Copy to .env (gitignored) or export these. NO VALUES BELONG IN GIT.
#
# Two environments, and they never meet:
#
#   TESTS       -> the machine's NATIVE PostgreSQL, database `vendor_app_test`.
#                  `npm test` drops its public schema and deletes every auth user on each
#                  run, then replays the migrations. No Docker, no Supabase CLI stack.
#   PRODUCTION  -> a Supabase Cloud project, reached only with `supabase db push`.
#
# The guard in tests/fixtures.mjs enforces the split: it resets `vendor_app_test` on a
# loopback server and refuses everything else -- including other databases on that same
# server, since other projects keep theirs there too.

# --- Tests ------------------------------------------------------------------
# Defaults to postgresql://postgres:postgres@127.0.0.1:5432/vendor_app_test, so you
# normally do not need to set this at all. Override only if your local superuser or port
# differs. The database name must stay vendor_app_test -- the guard requires it.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/vendor_app_test

# --- Production (Supabase Cloud) --------------------------------------------
# Not a secret: a 20-character project ref. Named here so that if a deploy shell's
# variables ever leak into a test run, the refusal says "the PRODUCTION project" rather
# than just "not a loopback host".
SUPABASE_PROD_PROJECT_REF=

# Personal access token for the Supabase CLI, if you are not using `supabase login`.
# This manages ALL your projects -- revoke it at
# https://supabase.com/dashboard/account/tokens when you no longer need it.
SUPABASE_ACCESS_TOKEN=
