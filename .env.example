# Copy to .env (gitignored) or export these in your shell. NO VALUES BELONG IN GIT.
#
# Two environments, and they never meet:
#
#   TESTS       -> the LOCAL `supabase start` stack. `npm test` drops its public schema
#                  and deletes every auth user on each run, then replays the migrations.
#   PRODUCTION  -> a Supabase Cloud project, reached only with `supabase db push`.
#
# The guard in tests/fixtures.mjs enforces the split: it resets loopback databases and
# refuses everything else, naming the production project explicitly when it recognises it.

# --- Tests (local stack) ----------------------------------------------------
# Both default to the local stack, so you normally do not need to set them at all.
# They exist so a deliberate override is possible -- and so a leftover export is visible.
# SUPABASE_API_URL=http://127.0.0.1:55321
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Required. From `supabase status -o json` after `supabase start`. The local anon key is
# public, but it is NOT stable across CLI versions -- read it, do not hardcode it.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Production (Supabase Cloud) --------------------------------------------
# Not a secret: a 20-character project ref. Named here so that if a deploy shell's
# variables ever leak into a test run, the refusal says "the PRODUCTION project" rather
# than just "not a loopback host".
SUPABASE_PROD_PROJECT_REF=

# Personal access token for the Supabase CLI, if you are not using `supabase login`.
# This manages ALL your projects -- revoke it at
# https://supabase.com/dashboard/account/tokens when you no longer need it.
SUPABASE_ACCESS_TOKEN=
