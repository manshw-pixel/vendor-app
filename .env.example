# Copy to .env (gitignored) or export these in your shell. NO VALUES BELONG IN GIT --
# not the keys, not the project refs.
#
# This project runs entirely on Supabase Cloud. There is no local stack. It expects TWO
# Cloud projects:
#
#   - the TEST project: empty and disposable. `npm test` drops its public schema and
#     deletes every one of its auth users on each run, then replays supabase/migrations/.
#   - the PRODUCTION project: your real data. The suite must never reach it. Deploys go
#     there with `supabase db push`, never with this suite.
#
# The guard in tests/fixtures.mjs enforces that split: it resets the project named by
# SUPABASE_TEST_PROJECT_REF and nothing else, and refuses outright if these disagree.

# The 20-character ref of the disposable test project (Dashboard -> Project Settings ->
# General -> Reference ID). Unset means the suite refuses to run at all.
SUPABASE_TEST_PROJECT_REF=

# The ref of your production project. Optional but recommended: naming it here makes the
# refusal explicit rather than incidental.
SUPABASE_PROD_PROJECT_REF=

# The TEST project's API URL. Must be the same project as SUPABASE_DB_URL.
SUPABASE_API_URL=https://<test-project-ref>.supabase.co

# The TEST project's connection string, from Project Settings -> Database.
# Must be SESSION mode on port 5432 -- the direct connection, or the session pooler. The
# transaction pooler (6543) cannot run the multi-statement DDL the reset sends and is
# refused by the guard.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<test-project-ref>.supabase.co:5432/postgres

# The TEST project's keys (Project Settings -> API). Per-project, and they rotate.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
